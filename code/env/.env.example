# ============================================================
# .env.example — Template for required environment variables
# ============================================================
# Copy this file to .env and fill in your API keys:
#   cp .env.example .env
#
# NEVER commit .env to git. Only .env.example is committed.
# ============================================================

# ── LLM / VLM / STT Provider API Keys & Credentials ──
# LiteLLM automatically reads these variables based on the model prefix in config.yaml:
#   • For "bedrock/..." models      ──► Set AWS_ACCESS_KEY_ID, AWS_SECRET_ACCESS_KEY, AWS_REGION_NAME
#   • For "fireworks_ai/..." models ──► Set FIREWORKS_API_KEY
#   • For "gemini/..." models       ──► Set GEMINI_API_KEY
#   • For "openai/..." models       ──► Set OPENAI_API_KEY
#   • For "anthropic/..." models    ──► Set ANTHROPIC_API_KEY
#
# Uncomment and populate the credentials for the provider(s) you wish to use:
# GEMINI_API_KEY=your-gemini-api-key-here
# OPENAI_API_KEY=your-openai-api-key-here
# ANTHROPIC_API_KEY=your-anthropic-api-key-here
# FIREWORKS_API_KEY=your-fireworks-api-key-here
# AWS_ACCESS_KEY_ID=your-aws-access-key-id-here
# AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key-here
# AWS_REGION_NAME=us-east-1

# ── Optional: Override model names from config.yaml without editing config ──
# ORCHESTRATE_LLM_MODEL=gemini/gemini-2.5-flash
# ORCHESTRATE_VLM_MODEL=gemini/gemini-2.5-flash
# ORCHESTRATE_STT_MODEL=openai/whisper-1
