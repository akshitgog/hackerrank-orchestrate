# Environment Variables for HackerRank Orchestrate: Ghost Data Still Exists
# DO NOT commit real secrets or the actual .env file to git.

# 1. Primary Reasoning & VLM (Vision-Language Model)
# Option A: Fireworks AI (e.g. Llama-3.2-Vision / Qwen2.5-VL / Llama-3.3-70B)
FIREWORKS_API_KEY=

# Option B: OpenAI (e.g. gpt-4o / gpt-4o-mini)
OPENAI_API_KEY=

# Option C: Google Gemini (e.g. gemini-2.5-flash)
GEMINI_API_KEY=

# 2. TypeSafe AI Jev: Structured Probabilistic Decision Model (used together with VLM/LLM)
TYPESAFE_JEV_API_KEY=
