{
  "schemas": {
    "1_system_inputs": {
      "claim_input": {
        "description": "Row from dataset/claims.csv",
        "fields": {
          "user_id": "string",
          "image_paths": "string (semicolon separated, relative to dataset base path)",
          "user_claim": "string",
          "claim_object": "string"
        }
      },
      "user_history": {
        "description": "Row from dataset/user_history.csv",
        "fields": {
          "user_id": "string",
          "past_claim_count": "integer",
          "accept_claim": "integer",
          "manual_review_claim": "integer",
          "rejected_claim": "integer",
          "last_90_days_claim_count": "integer",
          "history_flags": "string (semicolon separated)",
          "history_summary": "string"
        }
      },
      "evidence_requirements": {
        "description": "Row from dataset/evidence_requirements.csv",
        "fields": {
          "requirement_id": "string",
          "claim_object": "string",
          "applies_to": "string",
          "minimum_image_evidence": "string"
        }
      }
    },
    "1b_risk_engine": {
      "risk_engine_output": {
        "description": "Computed dynamic risk flags based on user history numerical statistics and static flags.",
        "fields": {
          "user_id": "string",
          "computed_risk_flags": "array[string] (e.g., ['user_history_risk'])"
        }
      }
    },
    "2_claim_extractor": {
      "extractor_output": {
        "description": "Generated by cheap LLM parsing the user_claim text",
        "fields": {
          "object": "string (e.g., car, laptop, package)",
          "component": "string (e.g., rear bumper, screen, seal)",
          "issue": "string (e.g., dent, crack, torn)"
        }
      }
    },
    "3_vlm_engine": {
      "vlm_input": {
        "description": "Injected into vlm_system_prompt.txt per image (user_id is passed through for internal tracking).",
        "fields": {
          "user_id": "string (from claim_input)",
          "object": "string (from extractor)",
          "component": "string (from extractor)",
          "issue": "string (from extractor)",
          "user_claim": "string (from claim_input)",
          "evidence_requirements": "string (loaded dynamically based on object/applies_to)",
          "image_id": "string (injected by assessor.py)",
          "image_local_path": "string (loaded from disk using base path in config)"
        }
      },
      "vlm_output": {
        "description": "Structured JSON returned by VLM per image. Note: 1 claim can yield 1-3 of these outputs.",
        "fields": {
          "user_id": "string",
          "image_id": "string",
          "object_detected": "string",
          "object_confidence": "integer (1-5)",
          "object_match": "boolean",
          "component_detected": "string",
          "component_visible": "boolean",
          "component_visibility": "integer (1-5)",
          "component_match": "boolean",
          "issue_detected": "string",
          "issue_visible": "boolean",
          "issue_strength": "integer (1-5)",
          "issue_match": "boolean",
          "issue_location_description": "string",
          "issue_severity": "enum (minor|medium|major|unknown)",
          "image_quality": "enum (good|acceptable|poor|unusable)",
          "image_quality_strength": "integer (1-5)",
          "quality_issues": "array[enum (blurry_image|low_resolution|poor_lighting|overexposed|underexposed|motion_blur)]",
          "authenticity_risk": "enum (low|medium|high)",
          "authenticity_flags": "array[enum (none|screenshot_detected|suspected_heavy_manipulation|suspected_ai_generated|annotation_present)]",
          "visibility_obstruction": "enum (none|cropped|object_partially_hidden|object_fully_hidden|wrong_angle)",
          "support_signal": "enum (support|contradict|insufficient)",
          "support_strength": "integer (1-5)",
          "requirement_failures": "array[enum (claimed_object_not_visible|claimed_component_not_visible|issue_not_visible|image_quality_insufficient|claimed_component_not_visible_due_to_crop|authenticity_concern)]",
          "reasoning": {
            "object_evidence": "string (max 15 words)",
            "component_evidence": "string (max 15 words)",
            "issue_evidence": "string (max 15 words)"
          }
        }
      }
    },
    "4_decision_engine": {
      "decision_input": {
        "description": "Data aggregated by Python orchestration layer. Bifurcates multi-image responses into a dictionary mapped by image_id.",
        "fields": {
          "user_id": "string",
          "image_paths": "string",
          "user_claim": "string",
          "claim_object": "string",
          "computed_risk_flags": "array[string] (from 1b_risk_engine.risk_engine_output)",
          "img_1": {
             "vlm_output": "object (3_vlm_engine.vlm_output)"
          },
          "img_n": {
             "vlm_output": "object (3_vlm_engine.vlm_output)"
          }
        }
      },
      "decision_intermediate_state": {
        "description": "Computed business logic state before NLP generation.",
        "fields": {
          "evidence_standard_met": "boolean",
          "claim_status": "enum (supported|contradicted|not_enough_information)",
          "supporting_image_ids": "array[string]",
          "valid_image": "boolean",
          "severity": "enum (none|low|medium|high|unknown)",
          "issue_type": "string (mapped from VLM issue_detected)",
          "object_part": "string (mapped from VLM component_detected)",
          "risk_flags_array": "array[string] (merged visual + history)",
          "best_image_vlm_reasoning": "object (extracted from the winning image's vlm_output.reasoning)"
        }
      }
    },
    "5_explanation_generator": {
      "generator_input": {
        "description": "Data passed into the Python templating engine (or cheap LLM) to write the final justifications.",
        "fields": {
          "claim_status": "string",
          "issue_type": "string",
          "object_part": "string",
          "risk_flags_array": "array[string]",
          "evidence_standard_met": "boolean",
          "best_image_vlm_reasoning": {
            "object_evidence": "string",
            "component_evidence": "string",
            "issue_evidence": "string"
          }
        }
      },
      "generator_output": {
        "description": "Final NLP strings generated by Python Templates or a cheap LLM. The schema remains identical regardless of which generation method is used.",
        "fields": {
          "evidence_standard_met_reason": "string",
          "claim_status_justification": "string"
        }
      }
    },
    "6_csv_writer": {
      "final_csv_row": {
        "description": "Final row written to output.csv. Assembled from inputs, decision engine, and explanation generator. MUST match exact column order and allowed values from problem_statement.md.",
        "fields": {
          "user_id": "string",
          "image_paths": "string",
          "user_claim": "string",
          "claim_object": "string",
          "evidence_standard_met": "enum ('true'|'false')",
          "evidence_standard_met_reason": "string (from 5_explanation_generator)",
          "risk_flags": "string (semicolon separated)",
          "issue_type": "string",
          "object_part": "string",
          "claim_status": "enum (supported|contradicted|not_enough_information)",
          "claim_status_justification": "string (from 5_explanation_generator)",
          "supporting_image_ids": "string (semicolon separated or 'none')",
          "valid_image": "enum ('true'|'false')",
          "severity": "enum (none|low|medium|high|unknown)"
        }
      }
    }
  }
}
