# AWS Bedrock Credentials (Primary Architecture)
AWS_ACCESS_KEY_ID="your_access_key_here"
AWS_SECRET_ACCESS_KEY="your_secret_key_here"
AWS_REGION_NAME="us-east-1"

# ---------------------------------------------------------
# Optional 3rd Party Providers (If pivoting away from AWS)
# ---------------------------------------------------------

# OpenAI API Key (For gpt-4o, gpt-4o-mini)
# OPENAI_API_KEY="sk-..."

# Anthropic API Key (For claude-3-5-sonnet, claude-3-haiku directly)
# ANTHROPIC_API_KEY="sk-ant-..."

# Google Gemini API Key (For gemini-1.5-pro, gemini-1.5-flash)
# GEMINI_API_KEY="..."

# Groq API Key (For ultra-fast open-source models like Llama3)
# GROQ_API_KEY="gsk_..."
